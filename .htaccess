# ─────────────────────────────────────────────────────────────
# ROADBASE – Passwortschutz über Login-Seite (login.php)
#
# Diese Datei als ".htaccess" (mit Punkt, ohne .txt) ins
# Hauptverzeichnis der Website legen – zusammen mit login.php.
#
# Funktionsweise: Wer das Login-Cookie nicht hat, wird bei
# JEDER Anfrage (auch Bilder, GLB usw.) zu login.php umgeleitet.
#
# Schutz aufheben: diese Datei löschen oder alle Zeilen
# unterhalb dieser Kommentare entfernen.
#
# WICHTIG: Der Token nach "roadbase_auth=" muss exakt dem
# AUTH_TOKEN in der login.php entsprechen!
# ─────────────────────────────────────────────────────────────

RewriteEngine On

# Die Login-Seite selbst bleibt immer erreichbar (sonst Endlosschleife)
RewriteCond %{REQUEST_URI} login\.php$
RewriteRule ^ - [L]

# Alle Anfragen ohne gültiges Login-Cookie zur Login-Seite umleiten
RewriteCond %{HTTP_COOKIE} !roadbase_auth=45463a6d791ddd6db2dfcb75f5e8bfead77e09b486e11ebb4c1ebbf6b729f23f
RewriteRule ^ login.php [L,R=302]
